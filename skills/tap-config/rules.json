{
  "_说明": "版面尺寸、字号、阈值等规则。字号单位为磅；整体放大/缩小字号用 brand.json 的 fonts.scale 或命令行 --font-scale。",

  "rules": {
    "word": {
      "page": {"width_cm": 21.0, "height_cm": 29.7, "margin_left_cm": 2.5, "margin_right_cm": 2.5,
               "margin_top_cm": 2.6, "margin_bottom_cm": 2.4, "header_cm": 1.3, "footer_cm": 1.2},
      "sizes": {"title": 26, "subtitle": 13, "h1": 16, "h2": 14, "h3": 12, "body": 10.5, "small": 9, "table": 9.5,
                "caption": 9, "footer": 8, "kpi": 22, "kpi_label": 9, "lead": 11.5, "quote": 12, "figure": 20},
      "line_spacing": 1.5,
      "para_after": 6,
      "heading_spacing": {"1": [24, 12], "2": [16, 8], "3": [10, 4]},
      "font_preset": {"default": "modern", "by_type": {"policy": "formal", "notice": "formal", "compliance": "formal"}},
      "indent_types": ["policy", "notice", "compliance"],
      "delta_headers": ["同比", "环比", "变化", "增减", "增速", "增长", "差异", "较上"],
      "toc_min_h1": 4,
      "kpi_range": [2, 4],
      "facts_cols": [1, 3],
      "progress_max": 10,
      "chart_dpi": 200,
      "review": {"long_paragraph": 320, "no_chart_types": ["policy", "notice"]},
      "content": {
        "_说明": "内容体检：渲染和质检时提示“空洞”内容。只提示不拦截；交付前逐条处理或在交付说明里解释。",
        "vague_words": ["尽快", "及时", "进一步", "大力", "全面", "显著", "积极", "切实", "着力", "扎实", "稳步", "不断",
                        "持续优化", "高度重视", "多措并举", "深入推进", "有效提升", "一定程度", "适时", "相关部门", "有关部门",
                        "等方面", "各方面", "若干", "较好", "较大", "明显", "有所", "加强", "完善", "提升"],
        "vague_per_para": 3,
        "thin_chapter_chars": 120,
        "topic_suffixes": ["情况", "分析", "概况", "概述", "介绍", "说明", "汇总", "总结", "现状", "简介"],
        "topic_max_len": 10,
        "title_exempt": ["常见问题", "术语解释", "附录", "版本记录", "联系方式", "风险提示", "责任免除", "签批"],
        "data_types": ["analysis", "project", "impact", "proposal"],
        "lead_types": ["analysis", "proposal", "training", "project", "impact", "product"],
        "lead_blocks": ["lead", "callout", "kpi", "exec_summary"],
        "bullet_min_chars": 8,
        "repeat_min_chars": 16,
        "max_listed": 15
      }
    },
    "excel": {
      "soon_days": 7,
      "spare_rows": 20,
      "kpi_range": [2, 8],
      "near_days": 2,
      "row_height": 20,
      "head_height": 30,
      "long_text_chars": 40,
      "long_text_width": 46,
      "col_width": [8, 40],
      "view_rows": 200,
      "board_rows": 60,
      "anomaly_rows": 30,
      "insight_max": 6,
      "heat_max_cols": 10,
      "range_rows": 2000,
      "review": {"freeze_rows": 15, "max_should": 15, "source_check": true}
    },
    "ppt": {
      "slide": {"width_in": 13.333, "height_in": 7.5, "margin_in": 0.6},
      "sizes": {"cover_title": 40, "cover_sub": 18, "section": 40, "title": 26, "title_min": 20, "kicker": 13,
                "h": 17, "body": 14, "small": 11.5, "tiny": 9.5, "big_num": 46, "num": 28},
      "bullets_split_over": 8,
      "bullets_per_page": 6,
      "kpis_max": 4,
      "process_max": 6,
      "anim_steps_max": 9,
      "repeat_run": 3,
      "topic_title_len": 6,
      "summary_min_content": 6,
      "agenda_min_sections": 2,
      "number_units": ["个百分点", "pct", "%", "亿元", "万元", "元", "亿", "万", "天", "个", "人", "次", "倍", "项", "家", "年", "月", "小时", "分钟", "分"],
      "title_max": 28,
      "topic_suffixes": ["情况", "分析", "概况", "概述", "介绍", "汇总", "总结", "说明", "一览", "现状"],
      "number_layouts": ["chart", "kpis", "bars", "gauge", "waterfall", "tilemap"],
      "highlight_max": 2,
      "timing": {"chars_per_min": 220, "min_per_slide": 0.5, "frame_min": 0.2},
      "exec_summary_max": 6,
      "brief": {"keep_types": ["cover", "exec_summary", "summary", "disclaimer", "end"], "per_section": 1},
      "limits": {"waterfall": 9, "tilemap": 12, "coverage": 6, "journey": 6, "roadmap_lanes": 6, "qa": 3, "radar_axes": 8},
      "tilemap_grid": [4, 5],
      "tilemap_regions": {"西北": [0, 0, 2, 2], "华北": [0, 2, 1, 2], "东北": [0, 4, 1, 1], "华中": [1, 2, 2, 2],
                          "华东": [1, 4, 2, 1], "西南": [2, 0, 2, 2], "华南": [3, 2, 1, 3]},
      "review": {"text_limit": 230, "text_limit_dense": 320, "dense_layouts": ["table", "matrix", "columns"]}
    },
    "impact": {
      "weights": {"importance": 0.55, "impact": 0.45},
      "levels": [["P0", 65], ["P1", 48], ["P2", 28], ["P3", 0]],
      "similarity_minor": 0.92,
      "min_ref_score": 0.35,
      "detail_levels": ["P0", "P1", "P2"],
      "detail_levels_brief": ["P0", "P1"],
      "detail_max": 12,
      "matrix_split": {"importance": 50, "impact": 40},
      "matrix_items_max": 5,
      "default_window_days": 30,
      "excerpt_chars": 240,
      "action_categories_max": 2,
      "review_flags": {"split_contain": 0.6, "split_min_chars": 10, "split_window": 3, "paraphrase_sim": 0.75},
      "experience": {"file": "experience/cases.jsonl", "top": 3, "min_score": 2, "general_max": 10},
      "verify": {"proposed_sim": 0.85},
      "revisions_max_in_report": 30,
      "human_max_in_report": 30
    }
  }
}

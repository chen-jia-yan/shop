  "fonts": {
    "_说明": "每个角色写一个“候选链”，按顺序选。cn 中文正文、head 中文标题（不写则同 cn）、en 西文、num 数字。mode=first：直接用第一个（文件在别人电脑上打开，以对方装的字体为准）；mode=installed：优先选本机已安装的。图表图片总是按本机已安装的选。可在内容 JSON 的 meta.fonts 或命令行 --font-cn / --font-en / --font-num / --font-mode / --font-scale 临时覆盖。",
    "mode": "first",
    "scale": 1.0,
    "cn": ["微软雅黑", "Microsoft YaHei", "PingFang SC", "思源黑体", "Source Han Sans SC", "Noto Sans CJK SC", "SimHei"],
    "en": ["Arial", "Helvetica Neue", "Helvetica", "Liberation Sans"],
    "num": ["Arial", "Helvetica Neue", "Helvetica", "Liberation Sans"],
    "quote": ["Georgia", "Times New Roman", "Liberation Serif"],
    "mono": ["Consolas", "Menlo", "Courier New"],
    "chart_extra": ["WenQuanYi Micro Hei", "DejaVu Sans"]
  },

  "fonts_by_scope": {},

  "font_presets": {
    "_说明": "字体方案。Word 按文档类型自动选（rules.json 的 rules.word.font_preset），也可 meta.font_preset 或 --font-preset 指定。modern：黑体系，适合方案、报告、产品资料、屏幕阅读；formal：标题黑体、正文宋体、西文 Times New Roman，适合制度、通知、合规等正式公文。",
    "modern": {
      "head": ["微软雅黑", "Microsoft YaHei", "PingFang SC", "思源黑体", "Source Han Sans SC", "Noto Sans CJK SC"],
      "cn": ["微软雅黑", "Microsoft YaHei", "PingFang SC", "思源黑体", "Source Han Sans SC", "Noto Sans CJK SC"],
      "en": ["Arial", "Helvetica Neue", "Helvetica", "Liberation Sans"],

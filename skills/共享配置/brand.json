  "fonts": {
    "_说明": "每个角色写一个“候选链”，按顺序选。mode=first：直接用第一个（文件在别人电脑上打开，以对方装的字体为准）；mode=installed：优先选本机已安装的。图表图片总是按本机已安装的选。可在内容 JSON 的 meta.fonts 或命令行 --font-cn / --font-en / --font-num / --font-mode / --font-scale 临时覆盖。",
    "mode": "first",
    "scale": 1.0,
    "cn": ["微软雅黑", "Microsoft YaHei", "PingFang SC", "思源黑体", "Source Han Sans SC", "Noto Sans CJK SC", "SimHei"],
    "en": ["Arial", "Helvetica Neue", "Helvetica", "Liberation Sans"],
    "num": ["Arial", "Helvetica Neue", "Helvetica", "Liberation Sans"],
    "quote": ["Georgia", "Times New Roman", "Liberation Serif"],
    "mono": ["Consolas", "Menlo", "Courier New"],
    "chart_extra": ["WenQuanYi Micro Hei", "DejaVu Sans"]
  },

  "fonts_by_scope": {

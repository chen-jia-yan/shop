{
  "_说明": "版式主题。颜色写 @色名（引用 brand.json 的 colors）或 #RRGGBB。可以新增主题：复制一段改名即可，命令行 --style / --theme 直接可选。",

  "themes": {
    "word": {
      "default_by_type": {
        "product": "classic", "proposal": "classic", "claims": "minimal", "underwriting": "minimal",
        "training": "classic", "policy": "minimal", "analysis": "premium", "project": "classic",
        "notice": "classic", "compliance": "minimal", "impact": "premium"
      },
      "fallback": "classic",
      "styles": {
        "classic": {
          "name": "经典橙白", "cover": "band",
          "cover_bg": "@primary", "cover_fg": "@white", "cover_accent": "@accent",
          "cover_brand": "@white", "cover_short": "@accent", "cover_category": "@accent",
          "cover_title": "@white", "cover_sub": "@white", "cover_label": "@muted", "cover_value": "@ink",
          "heading": "@primary", "heading_num": "@primary", "h2": "@secondary", "rule": "@primary",
          "table_head_bg": "@primary", "table_head_fg": "@white", "flat_head": false,
          "table_stripe": "@primary_pale", "table_total_bg": "@primary_light", "highlight_col_bg": "@accent_light",
          "kpi_bg": "@primary_pale", "kpi_bar": "@primary", "header_brand": "@primary", "header_text": "@muted"
        },
        "premium": {
          "name": "尊享深色", "cover": "full",
          "cover_bg": "@secondary", "cover_fg": "@white", "cover_accent": "@accent",
          "cover_brand": "@accent", "cover_short": "@white", "cover_category": "@accent",
          "cover_title": "@white", "cover_sub": "@on_dark", "cover_label": "@on_dark_muted", "cover_value": "@white",
          "heading": "@secondary", "heading_num": "@primary", "h2": "@secondary_mid", "rule": "@accent",
          "table_head_bg": "@secondary", "table_head_fg": "@white", "flat_head": false,
          "table_stripe": "@bg_soft", "table_total_bg": "@accent_light", "highlight_col_bg": "@primary_pale",
          "kpi_bg": "@secondary_light", "kpi_bar": "@accent", "header_brand": "@primary", "header_text": "@secondary_mid"
        },
        "minimal": {
          "name": "简约白", "cover": "line",
          "cover_bg": "@white", "cover_fg": "@ink", "cover_accent": "@primary",
          "cover_brand": "@primary", "cover_short": "@muted", "cover_category": "@muted",
          "cover_title": "@ink", "cover_sub": "@ink_soft", "cover_label": "@muted", "cover_value": "@ink",
          "heading": "@ink", "heading_num": "@primary", "h2": "@ink", "rule": "@primary",
          "table_head_bg": "@bg_soft", "table_head_fg": "@ink", "flat_head": true,
          "table_stripe": "@white", "table_total_bg": "@bg_soft", "highlight_col_bg": "@primary_pale",
          "kpi_bg": "@white", "kpi_bar": "@primary", "header_brand": "@primary", "header_text": "@muted"
        }
      },
      "callouts": {
        "key":     {"icon": "◆", "bar": "@primary",   "bg": "@primary_pale"},
        "summary": {"icon": "≡", "bar": "@secondary", "bg": "@secondary_light"},
        "info":    {"icon": "i", "bar": "@blue",      "bg": "@blue_light"},
        "tip":     {"icon": "✓", "bar": "@teal",      "bg": "@teal_light"},
        "warning": {"icon": "!", "bar": "@warn",      "bg": "@accent_light"},
        "risk":    {"icon": "!", "bar": "@red",       "bg": "@red_light"}
      }
    },

    "excel": {
      "default_by_kind": {
        "compare": "classic", "dashboard": "premium", "tracker": "minimal", "checklist": "classic",
        "calculator": "classic", "ledger": "minimal", "roster": "classic", "impact": "minimal"
      },
      "fallback": "classic",
      "styles": {
        "classic": {
          "name": "经典橙白",
          "title": "@primary", "title_bar": "@primary", "subtitle": "@ink_soft",
          "head_bg": "@primary", "head_fg": "@white", "flat_head": false,
          "stripe": "@primary_pale", "total_bg": "@primary_light",
          "hi_col": "@accent_light", "group_bg": "@secondary_light", "group_fg": "@secondary",
          "tile_bg": "@primary_pale", "tile_bar": "@primary", "tile_value": "@ink", "tile_label": "@ink_soft",
          "dark_tiles": false, "tab": "@primary", "accent": "@primary",
          "cover_bg": "@primary", "cover_fg": "@white", "cover_brand": "@accent", "cover_category": "@accent"
        },
        "premium": {
          "name": "尊享深色",
          "title": "@secondary", "title_bar": "@secondary", "subtitle": "@secondary_mid",
          "head_bg": "@secondary", "head_fg": "@white", "flat_head": false,
          "stripe": "@bg_soft", "total_bg": "@accent_light",
          "hi_col": "@primary_pale", "group_bg": "@primary_light", "group_fg": "@primary_dark",
          "tile_bg": "@secondary", "tile_bar": "@accent", "tile_value": "@white", "tile_label": "@on_dark",
          "dark_tiles": true, "tab": "@secondary", "accent": "@accent",
          "cover_bg": "@secondary", "cover_fg": "@white", "cover_brand": "@accent", "cover_category": "@accent"
        },
        "minimal": {
          "name": "简约白",
          "title": "@ink", "title_bar": "@primary", "subtitle": "@muted",
          "head_bg": "@bg_soft", "head_fg": "@ink", "flat_head": true,
          "stripe": null, "total_bg": "@bg_soft",
          "hi_col": "@primary_pale", "group_bg": "@bg_soft", "group_fg": "@ink",
          "tile_bg": "@white", "tile_bar": "@primary", "tile_value": "@ink", "tile_label": "@ink_soft",
          "dark_tiles": false, "tab": "@muted", "accent": "@primary",
          "cover_bg": "@white", "cover_fg": "@ink", "cover_brand": "@primary", "cover_category": "@muted"
        }
      },
      "roles": {
        "input_bg": "@accent_light", "input_border": "@warn", "formula_fg": "@secondary_mid", "todo_bg": "@todo_bg",
        "databar": "@primary_mid", "grey_bar": "@grey_bar"
      },
      "formats": {
        "text": "@", "int": "#,##0", "money": "#,##0", "money2": "#,##0.00", "wan": "#,##0.00",
        "yi": "0.00", "pct": "0.0%", "pct0": "0%", "ratio": "0.00", "date": "yyyy-mm-dd", "month": "yyyy-mm",
        "delta": "\"▲\"0.0%;\"▼\"0.0%;0.0%",
        "delta_pt": "\"▲\"0.0\"pct\";\"▼\"0.0\"pct\";0.0\"pct\""
      }
    },

    "ppt": {
      "default_by_deck": {
        "work_report": "minimal", "proposal": "orange", "training": "orange", "product": "orange",
        "project": "minimal", "analysis": "premium", "customer": "warm", "kickoff": "warm", "impact": "premium"
      },
      "fallback": "orange",
      "styles": {
        "orange": {
          "name": "橙白活力", "cover_style": "glow", "filled": true, "section_dark": true,
          "cover_bg": ["solid", "@primary"], "cover_fg": "@white", "cover_accent": "@accent",
          "cover_icon": "@primary_mid", "cover_icon_cut": "@primary",
          "section_bg": ["solid", "@primary"], "section_fg": "@white", "section_num": "@accent",
          "bg": "@white", "primary": "@primary", "secondary": "@secondary",
          "accent": "@accent", "soft": "@primary_pale", "soft2": "@primary_light",
          "title": "@ink", "card": "@white", "card_line": "@line", "deco": "@primary_light",
          "on_dark": "@on_dark", "on_dark_soft": "@on_dark_soft",
          "palette": ["@primary", "@secondary", "@primary_mid", "@secondary_soft", "@accent", "@muted", "@primary_dark", "@on_dark"],
          "funnel": ["@primary", "@primary_mid", "@secondary", "@secondary_soft", "@muted", "@on_dark"],
          "pyramid": ["@primary", "@primary_mid", "@secondary", "@secondary_soft", "@muted"],
          "bar_fill": "@primary_mid"
        },
        "premium": {
          "name": "尊享深色", "cover_style": "rings", "filled": true, "section_dark": true,
          "cover_bg": ["solid", "@secondary"], "cover_fg": "@white", "cover_accent": "@accent",
          "cover_icon": "@accent", "cover_icon_cut": "@secondary",
          "section_bg": ["solid", "@secondary"], "section_fg": "@white", "section_num": "@accent",
          "bg": "@white", "primary": "@secondary", "secondary": "@primary",
          "accent": "@accent", "soft": "@secondary_light", "soft2": "@secondary_tint",
          "title": "@secondary", "card": "@white", "card_line": "@line", "deco": "@secondary_tint",
          "on_dark": "@on_dark", "on_dark_soft": "@on_dark_soft", "cover_band": "@primary",
          "palette": ["@secondary", "@primary", "@primary_mid", "@secondary_soft", "@accent", "@muted", "@primary_dark", "@on_dark"],
          "funnel": ["@secondary", "@secondary_mid", "@secondary_soft", "@primary", "@primary_mid", "@muted"],
          "pyramid": ["@accent", "@primary", "@secondary", "@secondary_mid", "@secondary_soft"],
          "bar_fill": "@primary"
        },
        "minimal": {
          "name": "简约商务", "cover_style": "line", "filled": false, "section_dark": false,
          "cover_bg": ["solid", "@white"], "cover_fg": "@ink", "cover_accent": "@primary",
          "cover_icon": "@primary_light", "cover_icon_cut": "@primary_pale", "cover_deco": "@primary_pale",
          "section_bg": ["solid", "@bg_soft"], "section_fg": "@ink", "section_num": "@primary",
          "bg": "@white", "primary": "@primary", "secondary": "@ink_soft",
          "accent": "@primary", "soft": "@bg_soft", "soft2": "@bg_grey",
          "title": "@ink", "card": "@white", "card_line": "@line", "deco": "@bg_grey",
          "on_dark": "@muted", "on_dark_soft": "@muted",
          "palette": ["@primary", "@ink_soft", "@primary_mid", "@secondary_soft", "@accent", "@muted", "@primary_dark", "@on_dark"],
          "funnel": ["@primary", "@primary_mid", "@ink_soft", "@secondary_soft", "@muted", "@on_dark"],
          "pyramid": ["@primary", "@primary_mid", "@ink_soft", "@secondary_soft", "@muted"],
          "bar_fill": "@primary_mid"
        },
        "warm": {
          "name": "暖阳渐变", "cover_style": "glow", "filled": true, "section_dark": true,
          "cover_bg": ["gradient", "@primary", "@accent"], "cover_fg": "@white", "cover_accent": "@white",
          "cover_icon": "@white", "cover_icon_cut": "@accent_glow",
          "section_bg": ["gradient", "@primary", "@accent_warm"], "section_fg": "@white", "section_num": "@white",
          "bg": "@cream", "primary": "@primary", "secondary": "@secondary",
          "accent": "@accent", "soft": "@primary_pale", "soft2": "@primary_light",
          "title": "@ink", "card": "@white", "card_line": "@warm_line", "deco": "@primary_light",
          "on_dark": "@on_dark", "on_dark_soft": "@on_dark_soft",
          "palette": ["@primary", "@secondary", "@primary_mid", "@secondary_soft", "@accent", "@muted", "@primary_dark", "@on_dark"],
          "funnel": ["@primary", "@primary_mid", "@secondary", "@secondary_soft", "@muted", "@on_dark"],
          "pyramid": ["@primary", "@primary_mid", "@secondary", "@secondary_soft", "@muted"],
          "bar_fill": "@primary_mid"
        }
      }
    }
  }
}

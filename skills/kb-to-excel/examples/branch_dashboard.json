{
  "meta": {
    "title": "2026 年第三季度个险经营看板",
    "purpose": "汇总三季度个险渠道的规模、达成、人力与继续率，供管理层月度经营会使用。更新数据只需改各数据表里的原始数字，看板指标、洞察和图表全部由公式自动重算。",
    "kind": "dashboard",
    "style": "blue",
    "source": "示例样本，所有数字均为虚构",
    "date": "2026-10-15",
    "department": "战略规划部",
    "confidentiality": "内部",
    "dashboard_first": true
  },

  "params": [
    {"key": "target", "name": "季度目标（亿元）", "value": 14.0, "format": "yi", "desc": "公司季度新单保费目标"},
    {"key": "persist", "name": "继续率预警线", "value": 0.85, "format": "pct0", "desc": "低于该值标红"}
  ],

  "data": [
    {
      "name": "机构明细", "title": "区域机构经营明细（单位：亿元）", "source": "示例样本", "date": "2026-10-15", "key": "机构",
      "expect_rows": 5,
      "fields": [
        {"name": "机构", "type": "text", "required": true, "freeze": true},
        {"name": "新单保费", "type": "number", "format": "yi", "required": true},
        {"name": "去年同期", "type": "number", "format": "yi", "required": true},
        {"name": "目标", "type": "number", "format": "yi", "required": true},
        {"name": "有效人力", "type": "number", "format": "int", "required": true},
        {"name": "继续率", "type": "percent", "format": "pct", "required": true, "desc": "13 个月继续率"},
        {"name": "状态", "type": "select", "options": ["正常", "关注", "预警"], "styles": {"预警": "bad", "关注": "warn"}},
        {"name": "备注", "type": "longtext"},
        {"name": "同比", "type": "formula", "format": "pct", "formula": "=IFERROR({@新单保费}/{@去年同期}-1,0)"},
        {"name": "达成率", "type": "formula", "format": "pct", "formula": "=IFERROR({@新单保费}/{@目标},0)"},
        {"name": "人均产能（万元）", "type": "formula", "format": "ratio", "databar": true, "formula": "=IFERROR({@新单保费}*10000/{@有效人力},0)"}
      ],
      "rows": [
        ["华南", 4.10, 3.20, 3.60, 3200, 0.881, "正常", ""],
        ["华中", 3.20, 2.74, 2.90, 2500, 0.869, "正常", ""],
        ["西南", 2.70, 2.41, 2.60, 2300, 0.857, "关注", ""],
        ["华北", 2.40, 2.20, 2.00, 1900, 0.872, "正常", ""],
        ["华东", 2.60, 2.71, 2.90, 1900, 0.840, "预警", "二季度末两家合作网点调整，部分客户经理转岗，有效人力环比减少 6%"]
      ]
    },
    {
      "name": "产品结构", "title": "产品线新单保费与价值（单位：亿元）", "source": "示例样本", "date": "2026-10-15", "key": "产品线",
      "expect_rows": 5,
      "fields": [
        {"name": "产品线", "type": "text", "required": true},
        {"name": "新单保费", "type": "number", "format": "yi", "required": true},
        {"name": "价值率", "type": "percent", "format": "pct", "required": true, "input": true},
        {"name": "占比", "type": "formula", "format": "pct", "formula": "=IFERROR({@新单保费}/SUM({产品结构.新单保费}),0)"},
        {"name": "新业务价值", "type": "formula", "format": "yi", "formula": "={@新单保费}*{@价值率}"}
      ],
      "rows": [["重疾险", 4.65, 0.33], ["年金险", 4.20, 0.08], ["终身寿险", 3.00, 0.22], ["医疗险", 2.25, 0.25], ["其他", 0.90, 0.12]]
    },
    {
      "name": "季度趋势", "title": "近五个季度新单保费（单位：亿元）", "source": "示例样本", "date": "2026-10-15", "key": "季度",
      "expect_rows": 5,
      "fields": [
        {"name": "季度", "type": "text", "required": true},
        {"name": "新单保费", "type": "number", "format": "yi", "required": true},
        {"name": "同比增速", "type": "percent", "format": "pct0"}
      ],
      "rows": [["2025 Q3", 13.2, 0.03], ["2025 Q4", 11.8, 0.04], ["2026 Q1", 12.1, 0.06], ["2026 Q2", 13.4, 0.10], ["2026 Q3", 15.0, 0.14]]
    }
  ],

  "rules": [
    {"name": "未达成", "table": "机构明细", "when": "{@新单保费}<{@目标}", "level": "bad", "fields": ["达成率"]},
    {"name": "继续率低", "table": "机构明细", "when": "{@继续率}<{param.persist}", "level": "warn", "fields": ["继续率"]},
    {"name": "负增长", "table": "机构明细", "when": "{@新单保费}<{@去年同期}", "level": "bad", "fields": ["同比"]}
  ],

  "dashboard": {
    "name": "经营看板", "from": "机构明细", "title": "三季度经营驾驶舱",
    "kpis": [
      {"label": "新单保费", "value": "=SUM({机构明细.新单保费})", "unit": "亿元", "format": "yi", "tone": "down",
       "note": "=\"同比 \"&TEXT(IFERROR(SUM({机构明细.新单保费})/SUM({机构明细.去年同期})-1,0),\"+0.0%;-0.0%\")"},
      {"label": "目标达成率", "value": "=IFERROR(SUM({机构明细.新单保费})/{param.target},0)", "format": "pct",
       "note": "=\"季度目标 \"&TEXT({param.target},\"0.0\")&\" 亿元\"",
       "ring": "=MIN(1,IFERROR(SUM({机构明细.新单保费})/{param.target},0))"},
      {"label": "有效人力", "value": "=SUM({机构明细.有效人力})", "unit": "人", "format": "int",
       "note": "=\"人均产能 \"&TEXT(IFERROR(SUM({机构明细.新单保费})*10000/SUM({机构明细.有效人力}),0),\"0.0\")&\" 万元\""},
      {"label": "13 个月继续率", "value": "=IFERROR(AVERAGE({机构明细.继续率}),0)", "format": "pct",
       "note": "=\"低于预警线的区域 \"&COUNTIFS({机构明细.继续率},\"<\"&{param.persist})&\" 个\"",
       "ring": "=IFERROR(AVERAGE({机构明细.继续率}),0)"},
      {"label": "未完成目标", "value": "=COUNTIFS({机构明细.提醒标记},\"*未达成*\")", "unit": "个区域", "format": "int", "alert": true,
       "note": "=\"负增长区域 \"&COUNTIFS({机构明细.提醒标记},\"*负增长*\")&\" 个\""},
      {"label": "新业务价值", "value": "=SUM({产品结构.新业务价值})", "unit": "亿元", "format": "yi",
       "note": "=\"价值率 \"&TEXT(IFERROR(SUM({产品结构.新业务价值})/SUM({产品结构.新单保费}),0),\"0.0%\")"}
    ],
    "insights": [
      {"text": "=\"新单保费 \"&TEXT(SUM({机构明细.新单保费}),\"0.0\")&\" 亿元，达成率 \"&TEXT(IFERROR(SUM({机构明细.新单保费})/{param.target},0),\"0%\")&\"，同比 \"&TEXT(IFERROR(SUM({机构明细.新单保费})/SUM({机构明细.去年同期})-1,0),\"+0%;-0%\")"},
      {"text": "=\"增速最快：\"&INDEX({机构明细.机构},MATCH(MAX({机构明细.同比}),{机构明细.同比},0))&\"（同比 \"&TEXT(MAX({机构明细.同比}),\"+0%;-0%\")&\"）；达成率最高：\"&INDEX({机构明细.机构},MATCH(MAX({机构明细.达成率}),{机构明细.达成率},0))"},
      {"level": "bad", "text": "=\"未完成目标：\"&IFERROR(INDEX({机构明细.机构},MATCH(MIN({机构明细.达成率}),{机构明细.达成率},0)),\"—\")&\"，达成率 \"&TEXT(MIN({机构明细.达成率}),\"0%\")&\"；共 \"&COUNTIFS({机构明细.提醒标记},\"*未达成*\")&\" 个区域未达成\""},
      {"level": "warn", "text": "=\"价值率最低的产品线：\"&INDEX({产品结构.产品线},MATCH(MIN({产品结构.价值率}),{产品结构.价值率},0))&\"（\"&TEXT(MIN({产品结构.价值率}),\"0%\")&\"），占新单 \"&TEXT(INDEX({产品结构.占比},MATCH(MIN({产品结构.价值率}),{产品结构.价值率},0)),\"0%\")"}
    ],
    "group": {"title": "区域达成一览", "by": "机构", "values": ["华南", "华中", "西南", "华北", "华东"], "measures": [
      {"name": "新单保费", "agg": "sum", "field": "新单保费", "format": "yi", "databar": true},
      {"name": "目标", "agg": "sum", "field": "目标", "format": "yi"},
      {"name": "达成率", "agg": "avg", "field": "达成率", "format": "pct"},
      {"name": "继续率", "agg": "avg", "field": "继续率", "format": "pct"}]},
    "anomalies": {"title": "需要关注的区域", "columns": ["机构", "提醒标记", "达成率", "同比", "继续率", "状态"], "rows": 8},
    "charts": [
      {"type": "col", "title": "各区域新单保费与目标（亿元）", "data": "机构明细", "categories": "机构", "series": ["新单保费", "目标"]},
      {"type": "bar", "title": "华南同比增速领先，华东为负", "data": "机构明细", "categories": "机构", "series": ["同比"], "highlight": "华南", "number_format": "0%"},
      {"type": "combo", "title": "新单保费逐季回升，Q3 创年内新高", "data": "季度趋势", "categories": "季度", "series": ["新单保费"], "secondary": ["同比增速"], "secondary_format": "0%"},
      {"type": "donut", "title": "Q3 新单保费产品构成", "data": "产品结构", "categories": "产品线", "series": ["新单保费"]}
    ]
  },

  "sheets": [
    {"type": "notes", "name": "口径说明", "desc": "指标定义与数据来源",
     "sections": [
       {"heading": "指标定义", "items": [["新单保费", "首年规模保费，含期交首期和趸交"], ["达成率", "新单保费 ÷ 季度目标"], ["人均产能", "新单保费 ÷ 有效人力，单位万元/人"], ["13 个月继续率", "13 个月前生效的期交保单中，第 13 个月仍有效的比例"], ["价值率", "新业务价值 ÷ 新单保费"]]},
       {"heading": "数据来源", "items": ["本文件为示例，所有数字均为虚构。正式使用时从知识库中检索季度经营数据，并在此注明报表名称与取数日期。"]}
     ]}
  ]
}

{
  "meta": {
    "title": "2026 年销售行为合规自查整改跟踪",
    "purpose": "跟踪 10 月合规自查发现的问题及整改事项，供每周合规例会使用。原始问题和整改事项完整保留，状态与进度由各责任人每周五前更新。",
    "kind": "tracker",
    "style": "soft",
    "source": "2026 年 10 月销售行为合规自查报告（示例样本，均为虚构）",
    "date": "2026-11-16",
    "department": "合规部",
    "confidentiality": "内部",
    "disclaimer": "逾期、临近预警按打开文件当天的日期自动计算。"
  },

  "params": [
    {"key": "soon", "name": "临近提醒（天）", "value": 7, "format": "int", "desc": "距计划完成日不超过该天数时标“临近”"}
  ],

  "data": [
    {
      "name": "整改事项", "title": "整改事项", "source": "合规自查报告", "date": "2026-11-16", "key": "编号", "expect_rows": 10,
      "desc": "10 项整改事项的计划、状态和进度",
      "fields": [
        {"name": "编号", "type": "text", "required": true, "freeze": true},
        {"name": "整改事项", "type": "longtext", "required": true, "width": 36},
        {"name": "对应问题", "type": "text", "desc": "见“问题清单”"},
        {"name": "责任部门", "type": "select", "required": true,
         "options": ["个险渠道部", "产品部", "运营部", "培训部", "客户服务部", "银保渠道部", "人力资源部", "合规部"]},
        {"name": "责任人", "type": "person", "required": true, "input": true},
        {"name": "计划开始", "type": "date", "required": true},
        {"name": "计划完成", "type": "date", "required": true},
        {"name": "状态", "type": "select", "required": true, "input": true, "options": ["未开始", "进行中", "已完成"],
         "styles": {"未开始": "grey", "进行中": "info", "已完成": "good"}},
        {"name": "进度", "type": "percent", "input": true, "databar": true},
        {"name": "剩余天数", "type": "formula", "format": "int",
         "formula": "=IF({@状态}=\"已完成\",\"\",{@计划完成}-TODAY())", "desc": "负数为已逾期天数"},
        {"name": "预警", "type": "formula",
         "formula": "=IF({@状态}=\"已完成\",\"已完成\",IF(TODAY()>{@计划完成},\"逾期\",IF({@计划完成}-TODAY()<={param.soon},\"临近\",\"正常\")))",
         "styles": {"逾期": "bad", "临近": "warn", "已完成": "good"}}
      ],
      "rows": [
        ["ZG-01", "销售话术中删除“保本”“比存款划算”等表述", "WT-01", "个险渠道部", "陈**", "2026-10-12", "2026-10-30", "已完成", 1],
        ["ZG-02", "产品宣传折页补充犹豫期与等待期说明", "WT-02", "产品部", "林**", "2026-10-19", "2026-11-06", "已完成", 1],
        ["ZG-03", "双录抽检比例由 5% 提高到 10%", "WT-03", "运营部", "赵**", "2026-10-19", "2026-11-13", "进行中", 0.7],
        ["ZG-04", "代理人合规培训覆盖率补足至 100%", "WT-04", "培训部", "王**", "2026-10-26", "2026-11-27", "进行中", 0.6],
        ["ZG-05", "回访话术增加“是否理解退保损失”确认项", "WT-05", "客户服务部", "周**", "2026-11-02", "2026-11-20", "进行中", 0.8],
        ["ZG-06", "清理朋友圈违规宣传素材并建立月度巡检", "WT-06", "个险渠道部", "陈**", "2026-11-02", "2026-12-04", "进行中", 0.4],
        ["ZG-07", "投诉工单 48 小时首次响应机制上线", "", "客户服务部", "周**", "2026-11-09", "2026-12-18", "未开始", 0],
        ["ZG-08", "银保渠道销售资格核查与名单更新", "", "银保渠道部", "", "2026-11-16", "2026-12-11", "未开始", 0],
        ["ZG-09", "合规自查结果纳入季度绩效考核", "", "人力资源部", "郑**", "2026-11-23", "2027-01-08", "未开始", 0],
        ["ZG-10", "整改效果复查与报告", "", "合规部", "刘**", "2027-01-04", "2027-01-22", "未开始", 0]
      ]
    },
    {
      "name": "问题清单", "title": "自查发现问题清单", "source": "合规自查报告", "date": "2026-11-16", "key": "编号", "expect_rows": 6,
      "desc": "问题、依据、等级与对应整改事项",
      "fields": [
        {"name": "编号", "type": "text", "required": true, "freeze": true},
        {"name": "发现的问题", "type": "longtext", "required": true},
        {"name": "依据", "type": "longtext", "required": true},
        {"name": "等级", "type": "select", "required": true, "options": ["高", "中", "低"], "styles": {"高": "bad", "中": "warn"},
         "desc": "高 = 可能导致监管处罚或客户重大误解"},
        {"name": "整改事项", "type": "text"},
        {"name": "整改状态", "type": "formula",
         "formula": "=IFERROR(INDEX({整改事项.状态},MATCH({@整改事项},{整改事项.编号},0)),\"未关联\")",
         "styles": {"已完成": "good", "未关联": "warn"}, "desc": "取自“整改事项”"}
      ],
      "rows": [
        ["WT-01", "部分代理人话术中出现“保本”“比存款划算”等表述", "【请确认：适用的监管规定名称及条款】", "高", "ZG-01"],
        ["WT-02", "宣传折页未写明犹豫期、等待期", "公司《保险产品宣传材料管理办法》（示例）第 8 条", "高", "ZG-02"],
        ["WT-03", "双录抽检比例偏低，未能发现话术问题", "公司《销售过程管理规定》（示例）", "中", "ZG-03"],
        ["WT-04", "新入职代理人合规培训覆盖率 82%", "公司《代理人培训管理办法》（示例）", "中", "ZG-04"],
        ["WT-05", "回访未确认客户是否理解退保损失", "公司《新契约回访规范》（示例）", "中", "ZG-05"],
        ["WT-06", "朋友圈存在未经审核的产品宣传图", "公司《互联网宣传管理规定》（示例）", "高", "ZG-06"]
      ]
    }
  ],

  "rules": [
    {"name": "逾期", "table": "整改事项", "when": "{@预警}=\"逾期\"", "level": "bad", "fields": ["计划完成"]},
    {"name": "临近", "table": "整改事项", "when": "{@预警}=\"临近\"", "level": "warn", "fields": ["计划完成"]},
    {"name": "缺责任人", "table": "整改事项", "when": "AND({@状态}<>\"已完成\",{@责任人}=\"\")", "level": "warn", "fields": ["责任人"]},
    {"name": "进度不符", "table": "整改事项", "when": "AND({@状态}=\"已完成\",{@进度}<1)", "level": "info", "fields": ["进度"]},
    {"name": "高风险未改完", "table": "问题清单", "when": "AND({@等级}=\"高\",{@整改状态}<>\"已完成\")", "level": "bad", "fields": ["发现的问题"]}
  ],

  "views": [
    {"type": "list", "name": "视图·未完成", "from": "整改事项", "desc": "未完成事项，按计划完成日排序",
     "columns": ["编号", "整改事项", "责任部门", "责任人", "计划完成", "状态", "进度", "剩余天数", "预警", "提醒标记"],
     "where": "{@状态}<>\"已完成\"", "sort": "计划完成"},
    {"type": "board", "name": "视图·看板", "from": "整改事项", "group": "状态", "card": ["整改事项", "责任部门", "计划完成"],
     "desc": "按状态分列，逾期标红"}
  ],

  "dashboard": {
    "name": "仪表盘", "from": "整改事项", "title": "整改进度驾驶舱",
    "kpis": [
      {"label": "整改事项", "value": "=ROWS({整改事项.编号})", "unit": "项", "format": "int",
       "note": "=\"对应问题 \"&ROWS({问题清单.编号})&\" 个\""},
      {"label": "完成率", "value": "=IFERROR(COUNTIFS({整改事项.状态},\"已完成\")/ROWS({整改事项.编号}),0)", "format": "pct0", "tone": "down",
       "note": "=\"已完成 \"&COUNTIFS({整改事项.状态},\"已完成\")&\" 项\"",
       "ring": "=IFERROR(COUNTIFS({整改事项.状态},\"已完成\")/ROWS({整改事项.编号}),0)"},
      {"label": "平均进度", "value": "=IFERROR(AVERAGE({整改事项.进度}),0)", "format": "pct0",
       "ring": "=IFERROR(AVERAGE({整改事项.进度}),0)"},
      {"label": "已逾期", "value": "=COUNTIFS({整改事项.预警},\"逾期\")", "unit": "项", "format": "int", "alert": true, "tone": "up",
       "note": "=\"临近到期 \"&COUNTIFS({整改事项.预警},\"临近\")&\" 项\""},
      {"label": "高风险未改完", "value": "=COUNTIFS({问题清单.等级},\"高\",{问题清单.整改状态},\"<>已完成\")", "unit": "个",
       "format": "int", "alert": true, "note": "=\"高风险问题共 \"&COUNTIFS({问题清单.等级},\"高\")&\" 个\""}
    ],
    "insights": [
      {"level": "bad", "text": "=\"已逾期 \"&COUNTIFS({整改事项.预警},\"逾期\")&\" 项、临近到期 \"&COUNTIFS({整改事项.预警},\"临近\")&\" 项，请在周例会上逐项说明\""},
      {"text": "=\"整体完成率 \"&TEXT(IFERROR(COUNTIFS({整改事项.状态},\"已完成\")/ROWS({整改事项.编号}),0),\"0%\")&\"，平均进度 \"&TEXT(IFERROR(AVERAGE({整改事项.进度}),0),\"0%\")"},
      {"level": "warn", "text": "=\"缺责任人 \"&COUNTIFS({整改事项.提醒标记},\"*缺责任人*\")&\" 项\""}
    ],
    "group": {"title": "各部门进度", "by": "责任部门", "measures": [
      {"name": "事项", "agg": "count"},
      {"name": "已完成", "agg": "count", "where": [["状态", "已完成"]]},
      {"name": "逾期", "agg": "count", "where": [["预警", "逾期"]], "alert": true},
      {"name": "平均进度", "agg": "avg", "field": "进度", "format": "pct0", "databar": true}]},
    "breakdown": {"title": "预警分布", "by": "预警", "values": ["逾期", "临近", "正常", "已完成"]},
    "anomalies": {"title": "需要关注的事项", "columns": ["编号", "责任部门", "提醒标记", "计划完成", "进度"], "sort": "计划完成", "rows": 12}
  }
}

{
  "name": "ai-playwright-tests",
  "version": "1.0.0",
  "description": "AI 生成的 Playwright 测试脚本模板与执行器",
  "scripts": {
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression",
    "test:all": "playwright test",
    "executor": "npx ts-node playwright-executor/executor.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "playwright": "^1.45.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0"
  }
}

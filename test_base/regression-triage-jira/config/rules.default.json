{
  "tool": "ta-rules",
  "v": 2,
  "rules": {
    "env_exceptions": ["SessionNotCreatedException"],
    "env_patterns": [
      "ERR_CONNECTION_REFUSED", "ERR_CONNECTION_RESET", "ERR_CONNECTION_TIMED_OUT", "ERR_NAME_NOT_RESOLVED",
      "ERR_INTERNET_DISCONNECTED", "ERR_SSL_PROTOCOL_ERROR", "502 Bad Gateway", "503 Service Unavailable",
      "504 Gateway Time-out", "Connection refused", "Connection reset by peer", "Read timed out",
      "Max retries exceeded with url", "re:This version of \\w+ ?Driver only supports",
      "device offline", "设备离线", "device not found", "adb: device",
      "There is no active desktop", "DESKTOP_UNAVAILABLE", "re:'SetCursorPos'",
      "A transport-level error has occurred", "An existing connection was forcibly closed by the remote host",
      "re:A network-related or instance-specific error", "re:Timeout expired\\.\\s+The timeout period elapsed"
    ],
    "mass_min_cases": 5,
    "mass_ratio": 30,
    "mass_window_min": 15,
    "framework_paths": ["unittest\\", "unittest/", "BeautifulReport", "pywinauto\\", "pywinauto/", "PIL\\", "PIL/", "site-packages", "_pytest", "pluggy", "selenium/", "selenium\\", "appium"],
    "handler_funcs": ["save_img", "tearDown", "teardown", "take_screenshot", "screenshot"],
    "success_marks": ["re:job submitted(?!\\s*failed)", "re:\\b\\w+ succeeded\\b", "Save Successed", "Record Submitted", "re:trans_status\\s*:\\s*COMPLETED", "re:transaction COMPLETED"],
    "lock_messages": ["currently used by other user", "used by another user", "is locked", "locked by", "being used by", "正在被使用", "被锁定"],
    "config_messages": ["re:Cannot get [\\w ]*Config", "not configured", "configuration not found", "未配置", "找不到配置"],
    "crash_messages": ["Unhandled exception has occurred", "re:has stopped working", "未经处理的异常", "未處理的例外"],
    "desk_ambiguous": ["ElementAmbiguousError"],
    "desk_not_found": ["ElementNotFoundError", "MatchError", "re:Can't find window", "re:Could not find '"],
    "desk_not_visible": ["ElementNotVisible"],
    "desk_not_enabled": ["ElementNotEnabled"],
    "desk_option_missing": ["re:'[^']+' is not in list"],
    "desk_datetime": ["Failed to set time in Date Time Picker"],
    "masked_patterns": ["re:'(bool|NoneType)' object (has no attribute|is not subscriptable|is not iterable|is not callable)"],
    "overlay_keywords": ["modal", "dialog", "popup", "overlay", "mask", "backdrop", "toast", "cdk-overlay", "loading"],
    "noise_popups": ["Your session has expired", "會話已逾時", "会话已过期", "Save password", "要保存密码吗", "Restore pages", "还原页面", "We use cookies", "System Notice", "系統公告", "Allow notifications", "允许通知"],
    "business_errors": ["record not found", "not found", "invalid", "not allowed", "System error", "Internal Server Error", "please contact", "failed to", "錯誤", "错误", "失敗", "失败", "不存在", "無效", "无效"],
    "locator_exceptions": ["NoSuchElementException", "StaleElementReferenceException", "TimeoutException", "ElementNotInteractableException", "ElementNotVisibleException"],
    "intercept_exceptions": ["ElementClickInterceptedException"],
    "alert_exceptions": ["UnexpectedAlertPresentException"],
    "invalid_selector": ["InvalidSelectorException"],
    "code_errors": ["NameError", "AttributeError", "TypeError", "KeyError", "IndexError", "ImportError", "ModuleNotFoundError", "SyntaxError", "NullPointerException", "ClassCastException"],
    "test_code_paths": ["tests/", "testcases/", "test_", "pages/", "test_case", "system_view", "base_view"],
    "assertion_exceptions": ["AssertionError", "AssertionFailedError", "ComparisonFailure"],
    "expected_actual": ["re:expected[^\\n]{0,80}(actual|but (was|got)|but found)", "re:assert .+ == .+", "re:期望.{0,40}实际", "re:预期.{0,40}实际"],
    "fail_words": ["failed", "fail", "failure", "error", "broken", "失败", "错误", "不通过", "未通过", "异常"]
  }
}
